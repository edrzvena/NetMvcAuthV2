@model NetMvcAuthV2.DTOs.Auth.ForgotPasswordDto
@{
    ViewData["Title"] = "Lupa Password";
    Layout = "_AuthLayout";
}

<h1 class="h3 mb-1">Lupa password?</h1>
<p class="text-muted mb-4">Masukkan email Anda, kami akan mengirimkan tautan untuk membuat password baru.</p>

<form asp-action="ForgotPassword" method="post" data-auth-form novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Kirim Link Reset</button>
</form>

<p class="mt-4 mb-0 text-center"><a asp-action="Login">Kembali ke halaman masuk</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
