@model NetMvcAuthV2.DTOs.Auth.ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<h1 class="h3 mb-1">Bikin password baru</h1>
<p class="text-muted mb-4">Pilih password baru yang susah ditebak.</p>

<form asp-action="ResetPassword" method="post" data-auth-form novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <input asp-for="Token" type="hidden" />
    <span asp-validation-for="Token" class="d-block text-danger small mb-3"></span>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <div class="input-group">
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="NewPassword-hint" autofocus />
            <button type="button" class="btn btn-outline-secondary" data-toggle-password="NewPassword"
                    aria-label="Tampilkan password" aria-pressed="false">Tampilkan</button>
        </div>
        <div id="NewPassword-hint" class="form-text">Minimal 8 karakter, kombinasi huruf &amp; angka.</div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <div class="input-group">
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <button type="button" class="btn btn-outline-secondary" data-toggle-password="ConfirmPassword"
                    aria-label="Tampilkan password" aria-pressed="false">Tampilkan</button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Simpan Password Baru</button>
</form>

<p class="mt-4 mb-0 text-center"><a asp-action="Login">Kembali ke halaman masuk</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
